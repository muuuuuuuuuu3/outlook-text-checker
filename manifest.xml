<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:type="MailApp">

  <!-- アドインの一意なID（このままでOK） -->
  <Id>12345678-1234-1234-1234-123456789012</Id>
  <Version>1.0.0.0</Version>

  <!-- アドインの提供者名 -->
  <ProviderName>muuuuuuuuuu3</ProviderName>

  <!-- Outlookのストアに表示される名前と説明 -->
  <DefaultLocale>ja-JP</DefaultLocale>
  <DisplayName DefaultValue="誤字チェッカー"/>
  <Description DefaultValue="メール送信前に誤字をチェックするアドインです"/>

  <!-- アイコン画像 -->
  <IconUrl DefaultValue="https://muuuuuuuuuu3.github.io/outlook-text-checker/icon32.png"/>
  <HighResolutionIconUrl DefaultValue="https://muuuuuuuuuu3.github.io/outlook-text-checker/icon64.png"/>
  <SupportUrl DefaultValue="https://github.com/muuuuuuuuuu3/outlook-text-checker"/>

  <!-- どのOfficeアプリで動かすか -->
  <Hosts>
    <Host Name="Mail"/>
  </Hosts>

  <!-- 必要なOutlookのバージョン -->
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>

  <FormSettings>
    <!-- メール作成画面で表示するパネル -->
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://muuuuuuuuuu3.github.io/outlook-text-checker/taskpane.html"/>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <!-- アドインをどこに表示するか -->
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>

</OfficeApp>
